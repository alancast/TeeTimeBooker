# ForeUp / Mangrove Bay Credentials
# Create an account at the ForeUp booking site for Mangrove Bay
FOREUP_EMAIL=your@email.com
FOREUP_PASSWORD=your_secure_password
FOREUP_COURSE_ID=   # Optional: e.g. the numeric ID or slug from the booking URL

# Optional: Notifications
DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# AI Services (pick what you use)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# Browser / Bot Settings
HEADLESS=true
DRY_RUN=true
